  },
  "item": [
    {
      "name": "Get all countries",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "\r",
              "pm.test('Status is 200', () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test('Response is an array', () => {\r",
              "    pm.expect(json).to.be.an('array');\r",
              "});\r",
              "\r",
              "pm.test('Array is not empty and contains more than one country', () => {\r",
              "    pm.expect(json.length).to.be.greaterThan(1);\r",
              "});\r",
              "\r",
              "pm.test('Each country has all pulled fields', () => {\r",
              "    json.forEach((country) => {\r",
              "        pm.expect(country).to.have.property('name');\r",
              "        pm.expect(country).to.have.property('capital');\r",
              "        pm.expect(country).to.have.property('population');\r",
              "        pm.expect(country).to.have.property('currencies');\r",
              "        pm.expect(country).to.have.property('region');\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test('Population is positive and integer', () => {\r",
              "    json.forEach((country) => {\r",
              "        pm.expect(country.population).to.be.a(\"number\").and.to.be.greaterThan(0);\r",
              "    });\r",
              "});\r",
              "\r",
              "// set random country as env variable\r",
              "const randomIndex = Math.floor(Math.random()*json.length);\r",
              "const randomCountry = json[randomIndex].name.common.toLowerCase();\r",
              "\r",
              "pm.environment.set(\"country_name\", randomCountry);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{countries_url}}/all?fields=name,capital,population,region,currencies",
          "host": [
            "{{countries_url}}"
          ],
          "path": [
            "all"
          ],
          "query": [
            {
              "key": "fields",
              "value": "name,capital,population,region,currencies"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get by country name",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "const country = json[0]; // response is an object\r",
              "\r",
              "\r",
              "pm.test('Status is 200', () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test('Response is array', () => {\r",
              "    pm.expect(json).to.be.an('array');\r",
              "});\r",
              "\r",
              "pm.test('Country name returned equals {{country_name}}', () => {\r",
              "    pm.expect(country.name.common.toLowerCase()).to.eql(pm.environment.get('country_name'));\r",
              "});\r",
              "\r",
              "pm.test('Country has capital', () => {\r",
              "    pm.expect(country).to.have.property('capital');\r",
              "});\r",
              "\r",
              "pm.test('Country has valid population', () => {\r",
              "    pm.expect(country.population).to.be.a('number').and.to.be.greaterThan(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{countries_url}}/name/{{country_name}}",
          "host": [
            "{{countries_url}}"
          ],
          "path": [
            "name",
            "{{country_name}}"
          ]
        }
      },
      "response": []
    },
