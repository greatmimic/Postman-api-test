    {
      "name": "Filter country by currency",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "\r",
              "pm.test('Status is 200', () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test('Response returns array', () => {\r",
              "    pm.expect(json).to.be.an('array');\r",
              "});\r",
              "\r",
              "pm.test('Countries have currency field', () => {\r",
              "    json.forEach((country) => {\r",
              "        pm.expect(country).to.have.property('currencies');\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test('Countries have name', () => {\r",
              "    json.forEach((country) => {\r",
              "        pm.expect(country).to.have.property('name');\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test('Requested currency is present in countries', () => {\r",
              "    json.forEach((country) => {\r",
              "        //currency returns object so take key\r",
              "        const currencyKey = Object.keys(country.currencies); //should return \"USD\"\r",
              "        //include instead of eql since currencyKey is array and env currency is string\r",
              "        pm.expect(currencyKey).to.be.include(pm.environment.get('currency').toUpperCase())\r",
              "    \r",
              "    })\r",
              "});\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
