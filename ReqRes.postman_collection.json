  "item": [
    {
      "name": "Get full list of products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "const data = json.data;\r",
              "\r",
              "pm.test(\"Status is 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "})\r",
              "\r",
              "pm.test(\"Response is made of array\", () => {\r",
              "    pm.expect(data).to.be.an('array');\r",
              "})\r",
              "\r",
              "pm.test(\"Array contains at least one item\", () => {\r",
              "    pm.expect(data.length).greaterThan(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Each item has id, created_by, name, price, category, in_stock\", () => {\r",
              "    data.forEach((item) => {\r",
              "        pm.expect(item).to.have.property('id');\r",
              "        pm.expect(item.id).to.be.a('string');\r",
              "        pm.expect(item).to.have.property('created_by');\r",
              "        pm.expect(item.created_by).to.be.a('number');\r",
              "        pm.expect(item).to.have.property('data');\r",
              "        pm.expect(item.data).to.be.an('object');\r",
              "        pm.expect(item.data).to.have.property('name');\r",
              "        pm.expect(item.data.name).to.be.a('string');\r",
              "        pm.expect(item.data).to.have.property('price');\r",
              "        pm.expect(item.data.price).to.be.a('number');\r",
              "        pm.expect(item.data.price).greaterThan(0);\r",
              "        pm.expect(item.data).to.have.property('category');\r",
              "        pm.expect(item.data.category).to.be.a('string');\r",
              "        pm.expect(item.data).to.have.property('in_stock');\r",
              "        pm.expect(item.data.in_stock).to.be.a('boolean');\r",
              "        });\r",
              "\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
