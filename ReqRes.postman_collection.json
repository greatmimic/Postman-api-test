    {
      "name": "Get single product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "const id = response.data.id;\r",
              "\r",
              "pm.test(\"Status code is 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Check if id matches\", () => {\r",
              "    pm.expect(id).to.eql(pm.environment.get(\"id\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Check if all fields are present\", () => {\r",
              "    pm.expect(response.data).to.have.property(\"id\");\r",
              "    pm.expect(response.data).to.have.property(\"collection_id\");\r",
              "    pm.expect(response.data).to.have.property(\"project_id\");\r",
              "    pm.expect(response.data).to.have.property(\"app_user_id\");\r",
              "    pm.expect(response.data).to.have.property(\"created_by\");\r",
              "    pm.expect(response.data).to.have.property(\"created_at\");\r",
              "    pm.expect(response.data).to.have.property(\"updated_at\");\r",
              "    pm.expect(response.data).to.have.property(\"deleted_at\");\r",
              "    pm.expect(response.data).to.have.property(\"data\");\r",
              "    pm.expect(response.data.data).to.have.property(\"name\");\r",
              "    pm.expect(response.data.data).to.have.property(\"price\");\r",
              "    pm.expect(response.data.data).to.have.property(\"category\");\r",
              "    pm.expect(response.data.data).to.have.property(\"in_stock\");\r",
              "});"
            ],
